# Copy this file to .env.production (local) or server shared/.env.production
# Vite bakes these into the build at npm run build time

VITE_ENABLE_LOGGER=true
VITE_ENABLE_PERFORMANCE_TRACKING=false
VITE_AUTH_DEV_SHIM=dev
VITE_ENABLE_FOOTER_NAVIGATION=false
VITE_BASE_URL=/

VITE_COGNITO_USER_POOL_ID=your_pool_id
VITE_COGNITO_CLIENT_ID=your_client_id
VITE_COGNITO_REGION=us-east-1

# Node API — all browser API calls go here (Vue domain has NO /api routes)
# Staging server shared/.env  → https://node-build-stage.uy4sdjn4f7.com
# Production server shared/.env → https://node-build-prod.uy4sdjn4f7.com
VITE_API_BASE_URL=https://node-build-stage.uy4sdjn4f7.com

# Optional — separate services when needed
# VITE_WEB_BASE_URL=https://your-wp-site.com
# VITE_SCYLLADB_API_URL=http://localhost:3001
